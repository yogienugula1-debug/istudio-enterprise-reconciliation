import json
import re
import sqlite3
import pandas as pd

base_dir = (
    "/kaggle/input/datasets/yogendarenugula/istudio-enterprise-reconciliation-data"
)

# 1. Load FX & Users
df_fx = pd.read_csv(f"{base_dir}/daily_exchange_rates (1).csv")
df_fx["Date_str"] = pd.to_datetime(df_fx["Date"]).dt.strftime("%Y-%m-%d")
fx_map = dict(zip(df_fx["Date_str"], df_fx["EUR_to_USD"]))

conn = sqlite3.connect(f"{base_dir}/enterprise_database (1).db")
df_users = pd.read_sql("SELECT * FROM users", conn)
conn.close()

# Latest status per user
df_users["updated_dt"] = pd.to_datetime(df_users["updated_at"], errors="coerce")
df_latest_users = (
    df_users.sort_values("updated_dt")
    .groupby("user_id", as_index=False)
    .last()
)

# 2. Parse Server Logs
pattern = re.compile(r"^\[(?P<ts>[^\]]+)\]\s+(?P<level>[A-Z]+):\s+.*?payload=(?P<payload>\{.*\})")
records = []

with open(
    f"{base_dir}/server_logs (1).txt", "r", encoding="utf-8", errors="ignore"
) as f:
  next(f, None)  # skip header if 'Raw_Server_Log'
  for line in f:
    line = line.strip().strip('"')
    if not line:
      continue
    m = pattern.match(line)
    if not m:
      records.append({"raw_line": line, "parse_ok": False})
      continue
    payload_str = m.group("payload").replace('""', '"')
    try:
      p = json.loads(payload_str)
    except Exception:
      records.append({"raw_line": line, "parse_ok": False})
      continue

    ts = m.group("ts")
    date_str = ts[:10]
    eur_val = p.get("eur_val")
    failed_val = p.get("failed_val")
    amt_eur = float(eur_val) if eur_val is not None else 0.0
    fx_rate = fx_map.get(date_str)
    amt_usd = round(amt_eur * fx_rate, 2) if fx_rate is not None else None

    records.append({
        "timestamp": ts,
        "date": date_str,
        "level": m.group("level"),
        "user_id": p.get("u"),
        "item_code": p.get("item_code"),
        "eur_val": eur_val,
        "failed_val": failed_val,
        "amt_eur": amt_eur,
        "eur_to_usd": fx_rate,
        "amt_usd": amt_usd,
        "parse_ok": True,
    })

df_logs = pd.DataFrame(records)
df_recon = df_logs.merge(
    df_latest_users[["user_id", "name", "status"]], on="user_id", how="left"
)

# Flag issues/discrepancies
df_recon["issue_flag"] = "OK"
df_recon.loc[df_recon["level"] != "INFO", "issue_flag"] = "NON_INFO_LOG"
df_recon.loc[df_recon["failed_val"].notna(), "issue_flag"] = "FAILED_VALUE"
df_recon.loc[df_recon["status"].isna(), "issue_flag"] = "UNKNOWN_USER"
df_recon.loc[
    df_recon["status"].notna() & (df_recon["status"] != "Active"), "issue_flag"
] = "INACTIVE_USER"

# 3. CFO Summary
cfo_summary = pd.DataFrame([{
    "total_log_rows": len(df_recon),
    "valid_info_rows": int(
        (df_recon["level"] == "INFO") & (df_recon["failed_val"].isna())
    ).sum(),
    "total_eur_processed": round(
        df_recon.loc[df_recon["failed_val"].isna(), "amt_eur"].sum(), 2
    ),
    "total_usd_processed": round(
        df_recon.loc[df_recon["failed_val"].isna(), "amt_usd"].sum(), 2
    ),
    "total_failed_eur": round(
        pd.to_numeric(df_recon["failed_val"], errors="coerce").fillna(0).sum(),
        2,
    ),
    "flagged_rows_count": int((df_recon["issue_flag"] != "OK").sum()),
}])

df_recon.to_csv("/kaggle/working/reconciled_transactions.csv", index=False)
cfo_summary.to_csv("/kaggle/working/cfo_summary.csv", index=False)

print("=== CFO SUMMARY ===")
print(cfo_summary.to_string(index=False))
print("\n=== ISSUE BREAKDOWN ===")
print(df_recon["issue_flag"].value_counts())


valid_mask = (df_recon["level"] == "INFO") & (df_recon["failed_val"].isna())
cfo_summary = pd.DataFrame([{
    "total_log_rows": int(len(df_recon)),
    "valid_info_rows": int(valid_mask.sum()),
    "total_eur_processed": round(
        df_recon.loc[df_recon["failed_val"].isna(), "amt_eur"].sum(), 2
    ),
    "total_usd_processed": round(
        df_recon.loc[df_recon["failed_val"].isna(), "amt_usd"].sum(), 2
    ),
    "total_failed_eur": round(
        pd.to_numeric(df_recon["failed_val"], errors="coerce").fillna(0).sum(),
        2,
    ),
    "flagged_rows_count": int((df_recon["issue_flag"] != "OK").sum()),
}])

df_recon.to_csv("/kaggle/working/reconciled_transactions.csv", index=False)
cfo_summary.to_csv("/kaggle/working/cfo_summary.csv", index=False)

print("=== CFO SUMMARY ===")
print(cfo_summary.to_string(index=False))
print("\n=== ISSUE BREAKDOWN ===")
print(df_recon["issue_flag"].value_counts())


import matplotlib.pyplot as plt

# 1. Issue Breakdown Bar Chart
fig, axes = plt.subplots(1, 2, figsize=(12, 4))

issue_counts = df_recon["issue_flag"].value_counts()
axes[0].bar(issue_counts.index, issue_counts.values)
axes[0].set_title("Transaction Issue Breakdown")
axes[0].set_ylabel("Row Count")
axes[0].tick_params(axis="x", rotation=15)

# 2. Processed vs Failed EUR Chart
eur_totals = pd.Series({
    "Processed EUR": float(cfo_summary["total_eur_processed"].iloc[0]),
    "Failed EUR": float(cfo_summary["total_failed_eur"].iloc[0]),
})
axes[1].bar(eur_totals.index, eur_totals.values)
axes[1].set_title("Processed vs Failed EUR")
axes[1].set_ylabel("Amount (EUR)")

plt.tight_layout()
plt.savefig("/kaggle/working/cfo_reconciliation_charts.png", dpi=150)
plt.show()


